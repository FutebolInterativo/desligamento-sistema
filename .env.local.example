# Supabase — em Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=chave-anon-publica
SUPABASE_SERVICE_ROLE_KEY=chave-service-role-NUNCA-exponha-no-cliente

# URL pública da aplicação (usada para montar o link enviado ao advogado)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# E-mail transacional (Resend) — usado para enviar o link ao advogado
RESEND_API_KEY=
EMAIL_FROM=distrato@suaempresa.com
